# Furkan Saat — environment variables. Copy to .env.local and fill in.
# .env and .env.* files are git-ignored; only this example is committed.

# Supabase → Project Settings → API (Data API / API Keys).
# Both are public by design (they ship to the browser); the database's
# Row Level Security decides what each visitor may read or write.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_…) — or, on older projects, the "anon public" key
# (then name the variable NEXT_PUBLIC_SUPABASE_ANON_KEY instead).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The site's public address, used in e-mail links (confirmation, password reset).
# Development: http://localhost:4321 (npm run preview) or http://localhost:3000 (npm run dev).
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# NOT needed by this app today. If a server-only feature (payment webhooks,
# admin) ever needs the service role key, it must be read only in server code,
# never with a NEXT_PUBLIC_ prefix, and never committed.
# SUPABASE_SERVICE_ROLE_KEY=
