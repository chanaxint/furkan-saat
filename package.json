{
  "name": "furkan-saat",
  "version": "0.1.0",
  "private": true,
  "description": "Furkan Saat — multi-house luxury watch retailer. Cinematic editorial homepage.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "node -e \"require('fs').rmSync('.next/dev/types',{recursive:true,force:true})\" && next build && next start -p 4321",
    "db:products": "node scripts/products-seed.mjs",
    "db:test": "sh scripts/test-db.sh",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/unit/*.test.mjs\"",
    "test:admin-http": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 \"tests/admin-http/*.test.mjs\"",
    "test:admin-http:prod": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 tests/admin-http/prod.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.186.1"
  }
}
